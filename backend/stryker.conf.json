{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker"
  ],
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "reporters": ["html", "json", "clear-text", "progress"],
  "coverageAnalysis": "off",
  "mutate": [
    "plane-a/src/services/alert-evaluator.ts",
    "plane-a/src/services/entitlements.ts",
    "plane-a/src/routes/billing/**/*.ts",
    "shared/corridor.ts",
    "plane-a/src/routes/popular-corridors.ts",
    "plane-b/src/normalize/quote-normalizer.ts"
  ],
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 75
  }
}
