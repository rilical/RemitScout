{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "off",
  "mutate": [
    "plane-a/src/services/alert-evaluator.ts",
    "plane-a/src/services/entitlements.ts",
    "plane-a/src/routes/billing/**/*.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 70
  }
}
