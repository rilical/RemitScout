{
  "name": "remit-scout-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:plane-a": "tsx watch plane-a/src/server.ts",
    "dev:plane-c": "tsx watch plane-c/src/server.ts",
    "dev:plane-b": "tsx plane-b/src/ingest.ts",
    "build": "tsc -b plane-a plane-c plane-b",
    "start:plane-a": "node dist/plane-a/server.js",
    "start:plane-c": "node dist/plane-c/server.js",
    "start:plane-b": "node dist/plane-b/ingest.js",
    "lint": "eslint . --ignore-path ../.eslintignore",
    "test": "vitest run",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/ingest-run.ts",
    "ingest:run": "tsx scripts/ingest-run.ts",
    "guardrail:test": "node scripts/bronze-access-check.js",
    "guardrail:sql": "tsx scripts/sql-guardrail.ts",
    "guardrail:sql:plane-a": "tsx scripts/sql-guardrail.ts --plane-a",
    "guardrail:sql:plane-c": "tsx scripts/sql-guardrail.ts --plane-c",
    "probe:remitly": "tsx scripts/remitly-probe.ts",
    "probe:westernunion": "tsx scripts/westernunion-probe.ts",
    "probe:worldremit": "tsx scripts/worldremit-probe.ts",
    "probe:xe": "tsx scripts/xe-probe.ts",
    "probe:wise": "tsx scripts/wise-probe.ts",
    "probe:cache-ttl": "tsx scripts/cache-ttl-probe.ts",
    "probe:all": "pnpm probe:remitly && pnpm probe:wise && pnpm probe:xe && pnpm probe:worldremit && pnpm probe:westernunion",
    "sql:inventory": "tsx scripts/sql-guardrail.ts --inventory",
    "sql:inventory:plane-a": "tsx scripts/sql-guardrail.ts --plane-a --inventory",
    "sql:inventory:plane-c": "tsx scripts/sql-guardrail.ts --plane-c --inventory",
    "observe:westernunion": "tsx scripts/dev/westernunion-observe.ts",
    "b2c:refresh-worker": "tsx scripts/b2c-refresh-worker.ts",
    "b2c:retry-failed": "tsx scripts/b2c-retry-failed.ts",
    "gold:popular-corridors": "tsx scripts/gold-popular-corridors-job.ts",
    "gold:fx-rates": "tsx scripts/gold-fx-rates-job.ts",
    "gold:pulse-cache": "tsx scripts/gold-pulse-cache-job.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.1.3",
    "nodemailer": "^7.0.12",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "stripe": "^20.1.0",
    "undici": "^7.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.50.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
