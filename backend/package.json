    "weights:providers": "tsx scripts/provider-weighting-job.ts",
    "gold:publisher": "tsx scripts/gold-publisher-job.ts",
    "gold:live": "tsx scripts/gold-live-worker.ts",
    "gold:reconciliation": "tsx scripts/gold-reconciliation-job.ts",
    "alerts:corridor-refresh": "tsx scripts/alert-corridor-refresh-job.ts",
    "alerts:smart-signals": "tsx scripts/smart-alerts-job.ts",
    "oanda:sync-rates": "tsx scripts/oanda-rates-sync.ts",
    "oanda:sync-rates:once": "tsx scripts/oanda-rates-sync.ts --once",
    "volatility:backfill": "tsx scripts/volatility-backfill.ts",
    "tiers:seed": "tsx scripts/seed-manual-corridor-tiers.ts",
    "smart-alerts:refresh": "tsx scripts/smart-alerts-job.ts",
    "capability:probe": "tsx scripts/provider-capability-probe.ts",
    "ci:api-smoke": "tsx scripts/ci/api-smoke.ts",
    "ci:integration-smoke": "tsx scripts/ci/integration-smoke.ts",
    "ci:seed-sanity": "tsx scripts/ci/seed-sanity.ts",
    "ci:config-validate": "tsx scripts/ci/validate-runtime-config.ts",
    "ci:observability": "tsx scripts/ci/observability-check.ts"
