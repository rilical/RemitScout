    "probe:bossmoney": "tsx scripts/bossmoney-probe.ts",
    "probe:wise": "tsx scripts/wise-probe.ts",
    "probe:ria": "tsx scripts/ria-probe.ts",
    "probe:dahabshiil": "tsx scripts/dahabshiil-probe.ts",
    "probe:sendwave": "tsx scripts/sendwave-probe.ts",
