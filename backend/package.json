{
  "name": "remit-scout-backend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "volta": {
    "node": "20.19.0",
    "pnpm": "10.19.0"
  },
  "scripts": {
    "dev:plane-a": "tsx watch plane-a/src/server.ts",
    "dev:plane-c": "tsx watch plane-c/src/server.ts",
    "dev:plane-b:once": "tsx plane-b/src/ingest.ts",
    "build": "tsc -b plane-a plane-c plane-b scripts",
    "start:plane-a": "node dist/plane-a/server.js",
    "start:plane-c": "node dist/plane-c/server.js",
    "start:plane-b": "node dist/plane-b/ingest.js",
    "lint": "eslint . --ignore-path ../.eslintignore",
    "pretest": "node -e \"const [major, minor] = process.versions.node.split('.').map(Number); if (!(major === 20 && minor >= 19)) { console.error('ERROR: backend tests require Node 20.19+ (current: ' + process.versions.node + '). Run: nvm use'); process.exit(1); }\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "vitest run --coverage",
    "check:provider-score-drift": "node ../tools/check-provider-score-drift.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/ingest-run.ts",
    "ingest:run": "tsx scripts/ingest-run.ts",
    "guardrail:test": "node scripts/bronze-access-check.js",
    "guardrail:sql": "tsx scripts/sql-guardrail.ts",
