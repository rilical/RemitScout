{
  "name": "remit-scout-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:plane-a": "tsx watch plane-a/src/server.ts",
    "dev:plane-c": "tsx watch plane-c/src/server.ts",
    "dev:plane-b": "tsx plane-b/src/ingest.ts",
    "build": "tsc -b plane-a plane-c plane-b",
    "start:plane-a": "node dist/plane-a/server.js",
    "start:plane-c": "node dist/plane-c/server.js",
    "start:plane-b": "node dist/plane-b/ingest.js",
    "lint": "eslint . --ignore-path ../.eslintignore",
    "test": "vitest run",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "guardrail:test": "node scripts/bronze-access-check.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.1.3",
    "pg": "^8.12.0",
    "stripe": "^20.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.50.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
