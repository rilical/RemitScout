    "probe:placid": "tsx scripts/placid-probe.ts",
    "probe:cache-ttl": "tsx scripts/cache-ttl-probe.ts",
    "probe:all": "pnpm probe:remitly && pnpm probe:wise && pnpm probe:xe && pnpm probe:transfergo && pnpm probe:paysend && pnpm probe:pangea && pnpm probe:orbitremit && pnpm probe:bossmoney && pnpm probe:worldremit && pnpm probe:westernunion && pnpm probe:ria && pnpm probe:dahabshiil && pnpm probe:sendwave && pnpm probe:mukuru && pnpm probe:xoom && pnpm probe:instarem && pnpm probe:wirebarley && pnpm probe:wellsfargo && pnpm probe:alansari && pnpm probe:intermex && pnpm probe:koronapay && pnpm probe:remitbee && pnpm probe:singx && pnpm probe:placid",
