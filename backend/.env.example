# Agent LLM connector contract (Ralph loop)
# Connector matrix:
# - local/dev: AGENT_LLM_CONNECTOR=anthropic with AGENT_ANTHROPIC_API_KEY (or secret ARN)
# - staging/prod: AGENT_LLM_CONNECTOR=bedrock with AGENT_BEDROCK_REGION + AGENT_BEDROCK_MODEL_ID
# Secret precedence:
# - AGENT_ANTHROPIC_API_KEY from AGENT_ANTHROPIC_API_KEY_SECRET_ARN when present.
# - AGENT_BEDROCK_REGION / AGENT_BEDROCK_MODEL_ID may be resolved from AGENT_BEDROCK_SECRET_ARN.
AGENT_LLM_CONNECTOR=anthropic
AGENT_LLM_MODEL=claude-sonnet-4-20250514
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_PROMPT_VERSION=v1
AGENT_TELEMETRY_DIMS=
AGENT_ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_API_KEY_SECRET_ARN=
AGENT_BEDROCK_REGION=
AGENT_BEDROCK_MODEL_ID=
AGENT_BEDROCK_MAX_TOKENS=2048
AGENT_BEDROCK_SECRET_ARN=

# Queue staleness controls
QUEUE_STALENESS_ENFORCEMENT_ENABLED=0
STALE_WINDOW_GOLD_LIVE_MS=600000
STALE_WINDOW_FX_RATE_REFRESH_MS=1800000
STALE_WINDOW_INGEST_FANOUT_T1_MS=1200000
STALE_WINDOW_INGEST_FANOUT_T2_MS=14400000
STALE_WINDOW_QUOTE_REFRESH_MS=1800000
STALE_RESUME_GRACE_MS=0

