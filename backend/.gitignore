.env
.env.*
!.env.staging.example
!.env.local.example
dist
node_modules

# TypeScript compiled artifacts generated at build time must not be committed.
# Source .d.ts and .js files are generated by tsc and should live only in dist/.
# The plane-b/src tree accumulated these during a build-artifacts leak.
plane-b/src/**/*.d.ts
plane-b/src/**/*.js
plane-a/src/**/*.d.ts
plane-a/src/**/*.js
plane-c/src/**/*.d.ts
plane-c/src/**/*.js
scripts/**/*.d.ts
scripts/**/*.js
shared/**/*.d.ts
shared/**/*.js
