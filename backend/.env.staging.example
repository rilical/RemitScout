# Staging environment (isolated from production)
# Keep READ_ONLY_MODE=0 for isolated staging datasets.

# Global
NODE_ENV=staging
STRICT_CONFIG=1
READ_ONLY_MODE=0
LOG_LEVEL=info

# Plane A
PLANE_A_PORT=4000
PLANE_C_BASE_URL=https://plane-c-staging.remit-scout.com
PLANE_A_ADMIN_EMAILS=omar@remit-scout.com,austrilic@gmail.com,ghabayenedu@gmail.com,support@remit-scout.com
PLANE_A_ADMIN_REVOCATION_FAIL_CLOSED=0
PLANE_A_REQUIRE_API_KEY=1
PLANE_A_REQUIRE_JWT=1
PLANE_A_ENABLE_JWT_AUTH=1
PLANE_A_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
PLANE_A_JWT_AUDIENCES=authenticated
PLANE_A_API_KEYS=staging-key
PLANE_A_JWT_SECRET=change-me
PLANE_A_CORS_ORIGINS=https://staging.remit-scout.com
ALLOWED_ORIGINS=https://staging.remit-scout.com
PLANE_A_CORS_ALLOW_CREDENTIALS=1
PLANE_A_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
PLANE_A_CORS_ALLOWED_HEADERS=authorization,content-type,x-request-id,x-api-key
PLANE_A_B2C_CACHE_TTL_SECONDS=900
PLANE_A_B2C_JITTER_MS=300
PLANE_A_FX_RATE_CACHE_TTL_SECONDS=300
PLANE_A_LATEST_QUOTE_CACHE_TTL_SECONDS=15
PLANE_A_B2C_MAX_BUCKET_DELTA_PCT=0.25
ADMIN_IP_ALLOWLIST=<comma-separated-cidrs>

# Plane C
PLANE_C_PORT=4100

# Database (staging-only)
DATABASE_URL_PLANE_A=postgres://plane_a:plane_a@db-host:5432/remit
DATABASE_URL_PLANE_B=postgres://plane_b:plane_b@db-host:5432/remit
DATABASE_URL_PLANE_C=postgres://plane_c:plane_c@db-host:5432/remit

# Redis
REDIS_URL=redis://redis-host:6379/0

# Supabase (staging project only)
SUPABASE_URL=https://staging-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=staging-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=staging-supabase-service-role-key
SUPABASE_JWKS_URL=
SUPABASE_AUTH_VERIFY_MODE=auto
SUPABASE_AUTH_REMOTE_VERIFY_CACHE_TTL_SECONDS=30

# Stripe (test mode only in staging)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_ID_PLUS=price_change_me
STRIPE_PRICE_ID_PLUS_ANNUAL=price_change_me
FRONTEND_BASE_URL=https://staging.remit-scout.com
PUBLIC_SITE_URL=https://staging.remit-scout.com

# Alerts / newsletters / contact (disable side effects in staging)
ALERT_EMAIL_ENABLED=0
ALERTS_EMAIL_ENABLED=0
ALERTS_SMS_ENABLED=0
# If unset or empty, staging alerting via webhook is disabled.
# Set a real Slack Incoming Webhook URL for required alerting paths before enabling Plane A alert emitters.
ALERT_SLACK_WEBHOOK_URL=
ALERT_UNSUBSCRIBE_SECRET=change-me
ALERT_UNSUBSCRIBE_BASE_URL=https://staging.remit-scout.com
ALERT_UNSUBSCRIBE_TOKEN_TTL_HOURS=720
ALERT_EVALUATION_ENABLED=1
NEWSLETTER_EMAIL_ENABLED=0
NEWSLETTER_WELCOME_ENABLED=0
NEWSLETTER_BASE_URL=https://staging.remit-scout.com
CONTACT_EMAIL_ENABLED=0
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_FROM_NAME=
SES_FROM_ADDRESS=
SES_REGION=us-east-1
SNS_REGION=us-east-1

# Account deletion grace period
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_TOKEN_TTL_HOURS=168
ACCOUNT_DELETION_BASE_URL=https://staging-api.remit-scout.com
ACCOUNT_DELETION_EMAIL_ENABLED=1
ACCOUNT_DELETION_EMAIL_FROM=
ACCOUNT_DELETION_EMAIL_FROM_NAME=Remit-Scout Security

# Queues (staging-like, requires matching queue infrastructure)
QUOTE_REFRESH_QUEUE_MODE=queue
FX_RATE_REFRESH_QUEUE_MODE=queue
EXPORT_JOB_QUEUE_MODE=queue
PLANE_B_INGEST_FANOUT_QUEUE_MODE=queue
PLANE_B_NOTIFICATIONS_QUEUE_MODE=queue
PLANE_B_OPS_ALERT_QUEUE_MODE=queue
PLANE_B_DISABLE_TIER1=0

# Queue staleness controls
QUEUE_STALENESS_ENFORCEMENT_ENABLED=0
STALE_WINDOW_GOLD_LIVE_MS=600000
STALE_WINDOW_FX_RATE_REFRESH_MS=1800000
STALE_WINDOW_INGEST_FANOUT_T1_MS=1200000
STALE_WINDOW_INGEST_FANOUT_T2_MS=14400000
STALE_WINDOW_QUOTE_REFRESH_MS=1800000
STALE_RESUME_GRACE_MS=0

# Storage (use staging buckets or leave blank if not used)
BRONZE_S3_BUCKET=remit-scout-staging-bronze
PLANE_B_DB_POOL_MAX=8
PLANE_B_DB_POOL_MIN=1
DB_POOL_MAX=8
DB_POOL_MIN=1
BRONZE_S3_PREFIX=bronze
EXPORTS_S3_BUCKET=remit-scout-staging-exports
EXPORTS_S3_PREFIX=exports
AUDIT_LOGS_S3_BUCKET=
AUDIT_LOGS_S3_PREFIX=audit-logs
B2C_REFRESH_CONCURRENCY=1
INGEST_FANOUT_BATCH_SIZE=10
INGEST_FANOUT_CONCURRENCY=4
INGEST_FANOUT_PROVIDER_CONCURRENCY=2
PLANE_B_B2C_REFRESH_MAX_RETRIES=3
PLANE_B_B2C_LIVE_RPM=0

# Observability (optional)
CLOUDWATCH_METRICS_ENABLED=1
CLOUDWATCH_NAMESPACE=RemitScout
TRACING_EXPORTER=xray
SENTRY_DSN=change-me

# Optional FX/OANDA
FX_RATE_SECONDARY_PROVIDER=
FX_RATE_SECONDARY_BASE_URL=https://www.xe.com/api/protected/midmarket-converter/
FX_RATE_SECONDARY_AUTH_HEADER=
FX_RATE_SECONDARY_TIMEOUT_MS=5000
FX_RATE_SECONDARY_FAILURE_THRESHOLD=3
FX_RATE_SECONDARY_COOLDOWN_MS=300000
OANDA_API_KEY=
OANDA_USE_AUTHENTICATED_API=0
OANDA_SYNC_CURRENCIES=
OANDA_SYNC_INTERVAL_MINUTES=60
OANDA_RPM=60
OANDA_BURST_MULTIPLIER=2
OANDA_RATE_LIMIT_MAX_RETRIES=3
OANDA_RATE_LIMIT_BACKOFF_MS=1000
OANDA_RATE_LIMIT_BACKOFF_MAX_MS=10000
OANDA_RATE_LIMIT_JITTER_MS=250
OANDA_FALLBACK_MAX_WAIT_MS=1500
