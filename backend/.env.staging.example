# Staging environment (develop branch)
# Set READ_ONLY_MODE=1 if staging points at production data.

# Global
NODE_ENV=staging
STRICT_CONFIG=1
READ_ONLY_MODE=1
LOG_LEVEL=info

# Plane A
PLANE_A_PORT=4000
PLANE_C_BASE_URL=https://plane-c-staging.remit-scout.com
PLANE_A_ADMIN_EMAILS=admin@example.com
PLANE_A_REQUIRE_API_KEY=0
PLANE_A_REQUIRE_JWT=0
PLANE_A_API_KEYS=staging-key
PLANE_A_JWT_SECRET=change-me
PLANE_A_CORS_ORIGINS=https://staging.remit-scout.com
PLANE_A_CORS_ALLOW_CREDENTIALS=1
PLANE_A_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
PLANE_A_CORS_ALLOWED_HEADERS=authorization,content-type,x-request-id,x-api-key
PLANE_A_B2C_CACHE_TTL_SECONDS=900
PLANE_A_B2C_JITTER_MS=300
PLANE_A_FX_RATE_CACHE_TTL_SECONDS=300
PLANE_A_LATEST_QUOTE_CACHE_TTL_SECONDS=15

# Plane C
PLANE_C_PORT=4100

# Database (use staging if possible; otherwise point to prod)
DATABASE_URL_PLANE_A=postgres://plane_a:plane_a@db-host:5432/remit
DATABASE_URL_PLANE_B=postgres://plane_b:plane_b@db-host:5432/remit
DATABASE_URL_PLANE_C=postgres://plane_c:plane_c@db-host:5432/remit

# Redis
REDIS_URL=redis://redis-host:6379/0

# Supabase (shared prod project for staging)
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=prod-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=prod-supabase-service-role-key
SUPABASE_JWKS_URL=
SUPABASE_AUTH_VERIFY_MODE=auto
SUPABASE_AUTH_REMOTE_VERIFY_CACHE_TTL_SECONDS=30

# Stripe (shared prod account for staging)
STRIPE_SECRET_KEY=sk_live_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_ID_PLUS=price_change_me
FRONTEND_BASE_URL=https://staging.remit-scout.com
PUBLIC_SITE_URL=https://staging.remit-scout.com

# Alerts / newsletters / contact (disable side effects in staging)
ALERT_EMAIL_ENABLED=0
ALERTS_EMAIL_ENABLED=0
ALERTS_SMS_ENABLED=0
ALERT_SLACK_WEBHOOK_URL=
ALERT_UNSUBSCRIBE_SECRET=change-me
ALERT_UNSUBSCRIBE_BASE_URL=https://staging.remit-scout.com
ALERT_UNSUBSCRIBE_TOKEN_TTL_HOURS=720
ALERT_EVALUATION_ENABLED=0
NEWSLETTER_EMAIL_ENABLED=0
NEWSLETTER_WELCOME_ENABLED=0
NEWSLETTER_BASE_URL=https://staging.remit-scout.com
CONTACT_EMAIL_ENABLED=0
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_FROM_NAME=
SES_FROM_ADDRESS=
SES_REGION=us-east-1
SNS_REGION=us-east-1

# Queues (disabled in staging by default)
QUOTE_REFRESH_QUEUE_MODE=off
EXPORT_JOB_QUEUE_MODE=off
PLANE_B_INGEST_FANOUT_QUEUE_MODE=off
PLANE_B_NOTIFICATIONS_QUEUE_MODE=off
PLANE_B_OPS_ALERT_QUEUE_MODE=off

# Storage (use staging buckets or leave blank if not used)
BRONZE_S3_BUCKET=
BRONZE_S3_PREFIX=bronze
EXPORTS_S3_BUCKET=
EXPORTS_S3_PREFIX=exports
USER_ASSETS_S3_BUCKET=
USER_ASSETS_S3_PREFIX=avatars
AUDIT_LOGS_S3_BUCKET=
AUDIT_LOGS_S3_PREFIX=audit-logs

# Observability (optional)
CLOUDWATCH_METRICS_ENABLED=0
CLOUDWATCH_NAMESPACE=RemitScout
TRACING_EXPORTER=none
SENTRY_DSN=

# Optional FX/OANDA
OANDA_API_KEY=
OANDA_USE_AUTHENTICATED_API=0
OANDA_SYNC_CURRENCIES=
OANDA_SYNC_INTERVAL_MINUTES=60
