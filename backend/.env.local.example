# Local development defaults
NODE_ENV=development
LOG_LEVEL=debug

# Plane A / Plane C
PLANE_A_PORT=4000
PLANE_C_PORT=4100
PLANE_A_REQUIRE_API_KEY=0
PLANE_A_API_KEYS=dev-key
PLANE_A_REQUIRE_JWT=0
PLANE_A_JWT_SECRET=local-dev
PLANE_A_ADMIN_EMAILS=omar@remit-scout.com
PLANE_A_ADMIN_REVOCATION_FAIL_CLOSED=0
PLANE_C_BASE_URL=http://localhost:4100
PLANE_A_B2C_MAX_BUCKET_DELTA_PCT=0.25

# Database (local Docker)
DATABASE_URL=postgres://remit:remit@localhost:5432/remit
DATABASE_URL_PLANE_A=
DATABASE_URL_PLANE_B=
DATABASE_URL_PLANE_C=

# Redis (local Docker)
REDIS_URL=redis://localhost:6379/0

# Disable external integrations locally unless you intend to test them
NEWSLETTER_EMAIL_ENABLED=0
CONTACT_EMAIL_ENABLED=0
ALERT_EMAIL_ENABLED=0

# Supabase (optional)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=price_mock
FRONTEND_BASE_URL=http://localhost:3000

# Plane B
PLANE_B_DISABLE_TIER1=1

# Queue staleness controls
QUEUE_STALENESS_ENFORCEMENT_ENABLED=0
STALE_WINDOW_GOLD_LIVE_MS=600000
STALE_WINDOW_FX_RATE_REFRESH_MS=1800000
STALE_WINDOW_INGEST_FANOUT_T1_MS=1200000
STALE_WINDOW_INGEST_FANOUT_T2_MS=14400000
STALE_WINDOW_QUOTE_REFRESH_MS=1800000
STALE_RESUME_GRACE_MS=0

# Optional FX/OANDA
FX_RATE_SECONDARY_PROVIDER=
FX_RATE_SECONDARY_BASE_URL=https://www.xe.com/api/protected/midmarket-converter/
FX_RATE_SECONDARY_AUTH_HEADER=
FX_RATE_SECONDARY_TIMEOUT_MS=5000
FX_RATE_SECONDARY_FAILURE_THRESHOLD=3
FX_RATE_SECONDARY_COOLDOWN_MS=300000
OANDA_API_KEY=
OANDA_USE_AUTHENTICATED_API=0
OANDA_SYNC_CURRENCIES=
OANDA_SYNC_INTERVAL_MINUTES=60
OANDA_RPM=60
OANDA_BURST_MULTIPLIER=2
OANDA_RATE_LIMIT_MAX_RETRIES=3
OANDA_RATE_LIMIT_BACKOFF_MS=1000
OANDA_RATE_LIMIT_BACKOFF_MAX_MS=10000
OANDA_RATE_LIMIT_JITTER_MS=250
OANDA_FALLBACK_MAX_WAIT_MS=1500

# Privacy + compliance controls
PRIVACY_HASH_SALT=
PRIVACY_SESSION_SALT=
PRIVACY_SESSION_ROTATION_HOURS=24
PRIVACY_K_ANONYMITY_MIN=5
PRIVACY_CORRIDOR_MIN_DATA_POINTS_24H=100
PRIVACY_PROVIDER_MIN_QUOTES_PER_CORRIDOR=50
PRIVACY_TREND_MIN_LOOKBACK_DAYS=7
COMPLIANCE_GDPR_STATUS=compliant
COMPLIANCE_CCPA_STATUS=compliant
COMPLIANCE_SOC2_TYPE_II_STATUS=in_progress
COMPLIANCE_SOC2_TYPE_II_REPORT_STATE=in_progress
COMPLIANCE_SOC2_TYPE_II_REPORT_DATE=
COMPLIANCE_SOC2_TYPE_II_REPORT_URL=
COMPLIANCE_SOC2_TYPE_II_EXPIRES_ON=

# Account deletion grace period
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_TOKEN_TTL_HOURS=168
ACCOUNT_DELETION_BASE_URL=http://localhost:4000
ACCOUNT_DELETION_EMAIL_ENABLED=1
ACCOUNT_DELETION_EMAIL_FROM=
ACCOUNT_DELETION_EMAIL_FROM_NAME=Remit-Scout Security
