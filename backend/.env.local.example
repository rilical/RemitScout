# Local development defaults
NODE_ENV=development
LOG_LEVEL=debug

# Plane A / Plane C
PLANE_A_PORT=4000
PLANE_C_PORT=4100
PLANE_A_REQUIRE_API_KEY=0
PLANE_A_API_KEYS=dev-key
PLANE_A_REQUIRE_JWT=0
PLANE_A_JWT_SECRET=local-dev
PLANE_C_BASE_URL=http://localhost:4100

# Database (local Docker)
DATABASE_URL=postgres://remit:remit@localhost:5432/remit
DATABASE_URL_PLANE_A=
DATABASE_URL_PLANE_B=
DATABASE_URL_PLANE_C=

# Redis (local Docker)
REDIS_URL=redis://localhost:6379/0

# Disable external integrations locally unless you intend to test them
NEWSLETTER_EMAIL_ENABLED=0
CONTACT_EMAIL_ENABLED=0
ALERT_EMAIL_ENABLED=0

# Supabase (optional)
SUPABASE_MOCK=1
SUPABASE_MOCK_TOKEN=dev-token
SUPABASE_MOCK_ADMIN_TOKEN=admin-token
SUPABASE_MOCK_USER_ID=11111111-1111-4111-8111-111111111111
SUPABASE_MOCK_EMAIL=dev@example.com
SUPABASE_MOCK_ROLE=authenticated
SUPABASE_MOCK_ADMIN_EMAIL=admin@example.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional)
STRIPE_MOCK=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=price_mock
FRONTEND_BASE_URL=http://localhost:3000
