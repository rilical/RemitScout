{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.remit-scout.com/issueops/skill.schema.json",
  "title": "IssueOps Skill Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skills"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "purpose", "executor", "risk_tier"],
        "properties": {
          "skill_id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "executor": {
            "type": "string",
            "enum": ["github_actions", "aws_scheduled", "local_codex", "manual"]
          },
          "command": { "type": "string" },
          "workflow": { "type": "string" },
          "job": { "type": "string" },
          "required_inputs": { "type": "object" },
          "outputs": { "type": "object" },
          "risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "allOf": [
          {
            "if": { "properties": { "executor": { "const": "github_actions" } } },
            "then": { "required": ["workflow"] }
          },
          {
            "if": { "properties": { "executor": { "const": "local_codex" } } },
            "then": { "required": ["command"] }
          }
        ]
      }
    }
  }
}

