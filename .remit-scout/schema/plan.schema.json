{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remit-scout.local/schema/plan.schema.json",
  "title": "IssueOps Case Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "goal", "constraints", "skills", "guardrails"],
  "properties": {
    "case_id": { "type": "string", "minLength": 3 },
    "goal": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "executor", "params", "expected_artifacts", "stop_on_failure"],
        "properties": {
          "skill_id": { "type": "string", "minLength": 1 },
          "executor": {
            "type": "string",
            "enum": ["github_actions", "aws_scheduled", "local_codex", "manual"]
          },
          "params": { "type": "object" },
          "expected_artifacts": { "type": "array", "items": { "type": "string" } },
          "stop_on_failure": { "type": "boolean" }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runtime_minutes", "max_diff_lines", "prod_read_only"],
      "properties": {
        "max_runtime_minutes": { "type": "integer", "minimum": 1 },
        "max_diff_lines": { "type": "integer", "minimum": 0 },
        "prod_read_only": { "type": "boolean" }
      }
    }
  }
}

