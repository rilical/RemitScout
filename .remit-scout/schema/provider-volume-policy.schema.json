{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remit-scout.local/schema/provider-volume-policy.schema.json",
  "title": "Provider Volume Policy Catalog",
  "type": "object",
  "required": ["version", "providers"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "default_policy": {
      "$ref": "#/$defs/volume_policy"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "volume"],
        "additionalProperties": false,
        "properties": {
          "provider_id": { "type": "string", "minLength": 2 },
          "volume": { "$ref": "#/$defs/volume_policy" }
        }
      }
    }
  },
  "$defs": {
    "volume_strategy": {
      "type": "string",
      "enum": ["synthetic_seed", "reported", "inferred_proxy", "equal_weight"]
    },
    "volume_policy": {
      "type": "object",
      "required": [
        "strategy",
        "model_version",
        "fallback_chain",
        "synthetic_seed",
        "reported",
        "inferred_proxy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": { "$ref": "#/$defs/volume_strategy" },
        "model_version": { "type": "string", "minLength": 3 },
        "fallback_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/volume_strategy" }
        },
        "synthetic_seed": { "$ref": "#/$defs/synthetic_seed_policy" },
        "reported": { "$ref": "#/$defs/reported_policy" },
        "inferred_proxy": { "$ref": "#/$defs/inferred_proxy_policy" }
      }
    },
    "synthetic_seed_policy": {
      "type": "object",
      "required": ["default_weight", "default_confidence", "source_note", "corridor_overrides"],
      "additionalProperties": false,
      "properties": {
        "default_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "default_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_note": { "type": "string", "minLength": 1 },
        "corridor_overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/corridor_override" }
        }
      }
    },
    "corridor_override": {
      "type": "object",
      "required": ["corridor_id", "weight", "confidence", "source_note"],
      "additionalProperties": false,
      "properties": {
        "corridor_id": { "type": "string", "minLength": 3 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_note": { "type": "string", "minLength": 1 }
      }
    },
    "reported_policy": {
      "type": "object",
      "required": ["enabled", "source_ref", "freshness_slo_hours"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "source_ref": { "type": ["string", "null"] },
        "freshness_slo_hours": { "type": "integer", "minimum": 1, "maximum": 8760 }
      }
    },
    "inferred_proxy_policy": {
      "type": "object",
      "required": ["enabled", "factor_name", "lookback_days"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "factor_name": { "type": "string", "minLength": 1 },
        "lookback_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    }
  }
}
