{
  "name": "remit-scout-frontend",
  "version": "1.0.0",
  "description": "Remit-Scout - Compare money transfer providers",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./.nuxt/paths.mjs"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "seo:check": "node scripts/seo-check.mjs",
    "type-check": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "nuxt",
    "typescript",
    "tailwindcss",
    "remittance",
    "money-transfer"
  ],
  "author": "Remit-Scout",
  "license": "MIT",
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint-config": "^0.7.3",
    "@nuxt/image": "^1.8.1",
    "@nuxt/nitro": "^0.10.0",
    "@nuxtjs/robots": "^4.1.7",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^25.0.1",
    "nuxt": "^3.20.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.1.1"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@nuxt/kit": "^4.2.2",
    "@nuxtjs/i18n": "^8.5.6",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/supabase-js": "^2.49.1",
    "echarts": "^6.0.0",
    "katex": "^0.16.27",
    "pinia": "^3.0.4",
    "vue-echarts": "^8.0.1"
  }
}
