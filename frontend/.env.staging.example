# Staging environment (isolated from production)
NODE_ENV=staging

# Public URLs
PUBLIC_SITE_URL=https://staging.example.com
PUBLIC_API_BASE=https://staging-api.example.com/api/v1
PUBLIC_IMAGE_BASE=https://staging-cdn.example.com/images
PUBLIC_DEV_CONTROLS=0
PUBLIC_PULSE_ENABLED=1

# Server-side proxy target (must be absolute)
API_BASE=https://staging-api.example.com

# Supabase (staging project only)
PUBLIC_SUPABASE_URL=https://staging-project-ref.example.supabase.co
PUBLIC_SUPABASE_ANON_KEY=staging-supabase-anon-key
PUBLIC_AUTH_CLIENT_MFA_ENFORCED=0
# Local dev without Supabase: set NUXT_PUBLIC_SUPABASE_SUPPRESS_CONFIG_ERROR=1 to redirect auth errors to /sign-in

# Staging indexing policy
PUBLIC_ALLOW_SEARCH_INDEXING=0

# Analytics/ads/ezoic (placeholder IDs)
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
PUBLIC_X_PIXEL_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_REDDIT_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_NEW_RELIC_BROWSER_ENABLED=1
PUBLIC_NEW_RELIC_ACCOUNT_ID=0000000
PUBLIC_NEW_RELIC_TRUST_KEY=0000000
PUBLIC_NEW_RELIC_AGENT_ID=0000000000
PUBLIC_NEW_RELIC_APPLICATION_ID=0000000000
PUBLIC_NEW_RELIC_LICENSE_KEY=<new-relic-browser-license-key>
PUBLIC_NEW_RELIC_BEACON=bam.nr-data.net
PUBLIC_NEW_RELIC_ERROR_BEACON=bam.nr-data.net
PUBLIC_ENABLE_EZOIC=1
