# Staging environment (isolated from production)
NODE_ENV=staging

# Public URLs
PUBLIC_SITE_URL=https://staging.remit-scout.com
PUBLIC_API_BASE=https://staging-api.remit-scout.com/api/v1
PUBLIC_IMAGE_BASE=https://staging-cdn.remit-scout.com/images
PUBLIC_DEV_CONTROLS=0
PUBLIC_PULSE_ENABLED=1

# Server-side proxy target (must be absolute)
API_BASE=https://staging-api.remit-scout.com

# Supabase (shared prod project for staging)
PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=staging-supabase-anon-key
# Local dev without Supabase: set NUXT_PUBLIC_SUPABASE_SUPPRESS_CONFIG_ERROR=1 to redirect auth errors to /sign-in

# Staging indexing policy
PUBLIC_ALLOW_SEARCH_INDEXING=0

# Analytics/ads/ezoic (live IDs intentionally enabled for staging validation)
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
PUBLIC_ENABLE_EZOIC=1
