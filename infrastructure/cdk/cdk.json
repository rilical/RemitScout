{
  "app": "npx ts-node --project tsconfig.json bin/app.ts",
  "context": {
    "@aws-cdk/core:newStyleStackSynthesis": true,
    "planeAAdminEmails": [
      "admin@example.com"
    ],
    "sharedSecretArn": "arn:aws:secretsmanager:us-east-1:111111111111:secret:remit-scout/dev/communications-AbCdEf",
    "devPaused": true,
    "devMinimalInfra": false,
    "planeBB2bMaxQueueDepth": 5000,
    "planeBIngestDesiredCount": 0,
    "planeBB2cRefreshDesiredCount": 1,
    "planeBFxRateRefreshDesiredCount": 0,
    "planeBIngestFanoutTier1DesiredCount": 1,
    "planeBIngestFanoutTier2DesiredCount": 1,
    "goldLiveDesiredCount": 0,
    "planeBNotificationsDesiredCount": 0,
    "planeBOpsAlertsDesiredCount": 0,
    "planeBQueueWorkerDesiredCount": 0,
    "planeBQueueWorkerMaxCount": 1,
    "planeBDisableTier1": false,
    "enableFrontend": true,
    "cpuArchitecture": "arm64",
    "enableGithubActionsOidc": false,
    "enableSynthetics": false,
    "stagingBusinessHoursEnabled": true,
    "stagingPauseCron": "cron(0 18 ? * MON-FRI *)",
    "stagingResumeCron": "cron(0 9 ? * MON-FRI *)",
    "stagingTimezone": "America/New_York",
    "providerProbeMode": "fan_in",
    "stagingInterfaceEndpointsMode": "minimal",
    "opsResumeRuleAllowlist": [
      "b2c-retry-failed",
      "alert-evaluation-worker",
      "alert-evaluation-scheduler",
      "gold-fx-rates",
      "gold-reconciliation",
      "data-health-slo",
      "telemetry-analytics",
      "session-cleanup",
      "audit-log-cleanup",
      "smart-alerts",
      "alert-corridor-refresh"
    ]
  },
  "watch": {
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "node_modules",
      "cdk.out"
    ]
  },
  "output": "cdk.out",
  "build": "tsc",
  "test": {
    "command": "echo 'No tests configured'"
  }
}
