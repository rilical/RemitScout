{
  "_profile": "staging",
  "_description": "Staging — business hours only, minimal endpoints, fan-in probes",
  "enableSynthetics": false,
  "enableWaf": true,
  "enableCloudFront": true,
  "stagingBusinessHoursEnabled": true,
  "stagingPauseCron": "cron(0 18 ? * MON-FRI *)",
  "stagingResumeCron": "cron(0 9 ? * MON-FRI *)",
  "stagingTimezone": "America/New_York",
  "providerProbeMode": "fan_in",
  "stagingNatGateways": 1,
  "stagingInterfaceEndpointsMode": "minimal",
  "cpuArchitecture": "arm64",
  "planeBIngestDesiredCount": 1,
  "planeBB2cRefreshDesiredCount": 0,
  "planeBFxRateRefreshDesiredCount": 0,
  "planeBIngestFanoutTier1DesiredCount": 0,
  "planeBIngestFanoutTier2DesiredCount": 0,
  "goldLiveDesiredCount": 0,
  "planeBNotificationsDesiredCount": 0,
  "planeBOpsAlertsDesiredCount": 0,
  "alertEvaluationDesiredCount": 0,
  "exportWorkerDesiredCount": 0,
  "opsResumeRuleAllowlist": [
    "b2c-retry-failed",
    "alert-evaluation-worker",
    "alert-evaluation-scheduler",
    "gold-fx-rates",
    "gold-reconciliation",
    "data-health-slo",
    "telemetry-analytics",
    "session-cleanup",
    "audit-log-cleanup",
    "smart-alerts",
    "alert-corridor-refresh"
  ]
}
