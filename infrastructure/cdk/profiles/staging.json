{
  "_profile": "staging",
  "_description": "Staging — full QA parity, fan-in probes, custom-domain ready",
  "enableSynthetics": false,
  "enableWaf": true,
  "enableCloudFront": true,
  "stagingBusinessHoursEnabled": false,
  "stagingPauseCron": "cron(0 18 ? * MON-FRI *)",
  "stagingResumeCron": "cron(0 9 ? * MON-FRI *)",
  "stagingTimezone": "America/New_York",
  "providerProbeMode": "fan_in",
  "stagingNatGateways": 1,
  "stagingInterfaceEndpointsMode": "minimal",
  "cpuArchitecture": "arm64",
  "planeBDisableTier1": false,
  "planeBB2cRefreshServiceEnabled": true,
  "planeBFxRateRefreshServiceEnabled": true,
  "alertEvaluationServiceEnabled": true,
  "exportServiceEnabled": true,
  "agentOrchestratorServiceEnabled": true,
  "stressResponderServiceEnabled": true,
  "normalizationServiceEnabled": true,
  "planeBIngestDesiredCount": 1,
  "planeBB2cRefreshDesiredCount": 1,
  "planeBFxRateRefreshDesiredCount": 1,
  "planeBIngestFanoutTier1DesiredCount": 1,
  "planeBIngestFanoutTier2DesiredCount": 1,
  "goldLiveDesiredCount": 1,
  "planeBNotificationsDesiredCount": 1,
  "planeBOpsAlertsDesiredCount": 1,
  "alertEvaluationDesiredCount": 1,
  "exportWorkerDesiredCount": 1,
  "agentOrchestratorDesiredCount": 1,
  "stressResponderDesiredCount": 1,
  "normalizationWorkerDesiredCount": 1,
  "planeBQueueWorkerDesiredCount": 1,
  "planeBQueueWorkerMaxCount": 3,
  "opsResumeRuleAllowlist": [
    "b2c-retry-failed",
    "alert-evaluation-worker",
    "alert-evaluation-scheduler",
    "gold-fx-rates",
    "gold-reconciliation",
    "data-health-slo",
    "telemetry-analytics",
    "session-cleanup",
    "audit-log-cleanup",
    "smart-alerts",
    "alert-corridor-refresh"
  ]
}
