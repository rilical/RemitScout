ENVIRONMENT=staging
NODE_ENV=staging

# Brain loop controls
BRAIN_DISPATCH_GITHUB_ACTIONS=1
BRAIN_INGEST_GITHUB_ACTIONS=1
BRAIN_INGEST_MAX_PER_LOOP=5
BRAIN_SLACK_POST_CASE_CARDS=1
BRAIN_CREATE_GITHUB_ISSUE=1

# GitHub integration
GITHUB_REPOSITORY=owner/repo
GITHUB_REF=main
GITHUB_TOKEN=ghp_change_me

# Slack integration (shared with frontdesk bot)
SLACK_BOT_TOKEN=xoxb-change-me
SLACK_CASES_CHANNEL_ID=C0123456789

# Optional OpenClaw recommender contract
# OPENCLAW_CMD=./scripts/openclaw-wrapper.sh
