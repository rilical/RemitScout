{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.remit-scout.com/issueops/prd.schema.json",
  "title": "IssueOps Case PRD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "created_at",
    "env",
    "severity",
    "signal_sources",
    "domain",
    "symptoms",
    "suspected_components",
    "risk_tier",
    "risk_level",
    "owner_assignment",
    "acceptance_proof",
    "links"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "env": { "type": "string", "enum": ["dev", "staging", "prod"] },
    "severity": { "type": "string", "enum": ["sev0", "sev1", "sev2", "sev3"] },
    "signal_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "domain": {
      "type": "string",
      "enum": [
        "provider_health",
        "queue",
        "api_latency",
        "freshness",
        "indices",
        "pulse",
        "exports",
        "infra_drift",
        "security",
        "other"
      ]
    },
    "symptoms": { "type": "string", "minLength": 1 },
    "suspected_components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planes": {
          "type": "array",
          "items": { "type": "string", "enum": ["plane_a", "plane_b", "plane_c"] }
        },
        "services": { "type": "array", "items": { "type": "string" } },
        "providers": { "type": "array", "items": { "type": "string" } },
        "queues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "owner_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ownership_tag"],
      "properties": {
        "status": { "type": "string", "enum": ["unassigned", "assigned"] },
        "owner": { "type": "string", "minLength": 1 },
        "ownership_tag": {
          "type": "string",
          "pattern": "^[a-z0-9._:+-]+@v[0-9]+$"
        },
        "assigned_at": { "type": "string", "minLength": 10 },
        "assignment_note": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "unassigned" }
          }
        },
        {
          "required": ["owner"],
          "properties": {
            "status": { "const": "assigned" }
          }
        }
      ]
    },
    "human_owner": { "type": "string" },
    "ownership_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._:+-]+@v[0-9]+$"
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task_lifecycle_version",
        "runtime_stage_gates",
        "spec_refs",
        "bounded_evidence",
        "rollback_evidence"
      ],
      "properties": {
        "version": { "type": "string", "enum": ["v1"] },
        "task_lifecycle_version": {
          "type": "string",
          "enum": ["v1"],
          "description": "Versioned task-progress lifecycle contract. v1 statuses: todo|in_progress|blocked|done. v1 transitions: todo->in_progress|blocked, in_progress->done|blocked|todo, blocked->todo|in_progress. Same-state updates are idempotent no-ops."
        },
        "parallelizable_tag": {
          "type": "string",
          "pattern": "^[a-z0-9._:+-]+@v[0-9]+$"
        },
        "runtime_stage_gates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9._:+-]+@v[0-9]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9._:+-]+@v[0-9]+$"
            }
          }
        },
        "spec_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+/?$"
          }
        },
        "bounded_evidence": { "type": "boolean" },
        "rollback_evidence": { "type": "boolean" }
      }
    },
    "acceptance_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_note",
        "acceptance_note",
        "bounded_evidence_note",
        "rollback_evidence_note"
      ],
      "properties": {
        "source_note": { "type": "string", "minLength": 1, "maxLength": 300 },
        "acceptance_note": { "type": "string", "minLength": 1, "maxLength": 500 },
        "bounded_evidence_note": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rollback_evidence_note": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_issue", "dashboards", "cloudwatch_alarms"],
      "properties": {
        "github_issue": { "type": "string" },
        "github_pr": { "type": "string" },
        "cloudwatch_alarms": { "type": "array", "items": { "type": "string" } },
        "dashboards": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["risk_tier"],
        "properties": { "risk_tier": { "const": 0 } }
      },
      "then": {
        "properties": { "risk_level": { "const": "low" } }
      }
    },
    {
      "if": {
        "required": ["risk_tier"],
        "properties": { "risk_tier": { "const": 1 } }
      },
      "then": {
        "properties": { "risk_level": { "const": "medium" } }
      }
    },
    {
      "if": {
        "required": ["risk_tier"],
        "properties": { "risk_tier": { "const": 2 } }
      },
      "then": {
        "properties": { "risk_level": { "const": "high" } }
      }
    },
    {
      "if": {
        "required": ["risk_tier"],
        "properties": { "risk_tier": { "const": 3 } }
      },
      "then": {
        "properties": { "risk_level": { "const": "critical" } }
      }
    }
  ]
}
