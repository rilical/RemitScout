{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remit-scout.local/schema/prd.schema.json",
  "title": "IssueOps Case PRD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "created_at",
    "env",
    "severity",
    "signal_sources",
    "domain",
    "symptoms",
    "suspected_components",
    "risk_tier",
    "links"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "env": { "type": "string", "enum": ["dev", "staging", "prod"] },
    "severity": { "type": "string", "enum": ["sev0", "sev1", "sev2", "sev3"] },
    "signal_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "domain": {
      "type": "string",
      "enum": [
        "provider_health",
        "queue",
        "api_latency",
        "freshness",
        "indices",
        "pulse",
        "exports",
        "infra_drift",
        "security",
        "other"
      ]
    },
    "symptoms": { "type": "string", "minLength": 1 },
    "suspected_components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planes": {
          "type": "array",
          "items": { "type": "string", "enum": ["plane_a", "plane_b", "plane_c"] }
        },
        "services": { "type": "array", "items": { "type": "string" } },
        "providers": { "type": "array", "items": { "type": "string" } },
        "queues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "human_owner": { "type": "string" },
    "ownership_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._:+-]+@v[0-9]+$"
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "spec_refs", "bounded_evidence", "rollback_evidence"],
      "properties": {
        "version": { "type": "string", "enum": ["v1"] },
        "spec_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "bounded_evidence": { "type": "boolean" },
        "rollback_evidence": { "type": "boolean" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_issue", "dashboards", "cloudwatch_alarms"],
      "properties": {
        "github_issue": { "type": "string" },
        "github_pr": { "type": "string" },
        "cloudwatch_alarms": { "type": "array", "items": { "type": "string" } },
        "dashboards": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
