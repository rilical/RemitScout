# Secrets and environment files (never commit secrets to Git)
secrets/**
!secrets/README.md
*.env
*.env.local
*.env.*.local
*.secret.json
.env
.env.*
**/.env
**/.env.*
!**/.env*.example
!**/.env.example

# Node dependencies and build artifacts
node_modules/
dist/
build/
.next/
.nuxt/
.output/
.pnpm-store/

# TypeScript declaration files generated by tsc belong in dist/, not in src/.
# Backend source .d.ts files leaked into git; gitignore them so they stay out.
backend/plane-a/src/**/*.d.ts
backend/plane-b/src/**/*.d.ts
backend/plane-c/src/**/*.d.ts
backend/scripts/**/*.d.ts
backend/scripts/**/*.js
!backend/scripts/bronze-access-check.js
backend/shared/**/*.d.ts

# CDK Infrastructure
cdk.out/
cdk.out*/
cdk.context.json
infrastructure/cdk/cdk.out/
infrastructure/cdk/cdk.out*/
infrastructure/cdk/cdk.out.*/
infrastructure/cdk/cdk.out.deploy.*/
infrastructure/cdk/cdk.out.staging*/
infrastructure/cdk/*.js
infrastructure/cdk/*.d.ts
infrastructure/cdk/asset.*
infrastructure/cdk/*.tsbuildinfo
!infrastructure/cdk/*.config.js
!infrastructure/cdk/jest.config.js
# Keep cdk.context.json (needed for reproducible builds)
!infrastructure/cdk/cdk.context.json

# Coverage reports
backend/coverage/
coverage/
*.lcov

# Provider fixtures
backend/plane-b/src/providers/*/fixtures/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# Local tooling
tools/aws-cli/

# Temporary files
*.tmp
*.temp
*.cache
.cache/
.temp/
backend/tmp/
backend/tmp_*.ts
backend/tmp-*.ts
frontend/tmp/

# CI/contract artifacts (local-only)
artifacts/

# Local audit artifacts (often contain sensitive AWS details)
docs/audits/

# Codex/agent artifacts (local-only)
codex-aarch64-apple-darwin.dmg

# Ralph orchestrator artifacts are local-only
.ralph/
.worktrees/
.claude/worktrees/

# Ralph orchestrator config is tracked (project source-of-truth).
# If you need local overrides, use a separate local file.
.worktrees/
