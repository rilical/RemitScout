{
  "name": "remit-scout-v2",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <21 || >=22"
  },
  "volta": {
    "node": "20.19.0",
    "pnpm": "10.19.0"
  },
  "scripts": {
    "lint": "eslint backend",
    "lint:compliance": "eslint backend",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "verifier:emit:passed": "node scripts/verifier/emit-verify.mjs verify.passed --json '{}'",
    "verifier:emit:failed": "node scripts/verifier/emit-verify.mjs verify.failed --json '{}'",
    "verifier:smoke": "node scripts/verifier/smoke.mjs",
    "dev:all": "bash scripts/dev/start-local.sh",
    "dev:backend": "RUN_FRONTEND=0 bash scripts/dev/start-local.sh",
    "ops:newrelic:dashboards": "node ops/newrelic/bootstrap-dashboards.mjs",
    "ops:newrelic:alerts": "node ops/newrelic/sync-alerts.mjs",
    "ops:newrelic:cloud-links": "node ops/newrelic/sync-cloud-links.mjs",
    "ops:newrelic:workloads": "node ops/newrelic/sync-workloads.mjs",
    "ops:newrelic:notifications": "node ops/newrelic/sync-notifications-workflows.mjs",
    "ops:newrelic:full": "node ops/newrelic/bootstrap-all.mjs",
    "ops:newrelic:verify": "node ops/newrelic/verify-signals.mjs",
    "verifier:contract": "node scripts/verifier/check-quality-contract.mjs",
    "verifier:workflow-consumer-contract": "node scripts/verifier/check-workflow-consumer.mjs",
    "ralph:plan": "node scripts/ralph/plan.mjs build",
    "ralph:sync-specs": "node scripts/ralph/plan.mjs sync",
    "ralph:next": "node scripts/ralph/plan.mjs next",
    "ralph:loop:plan": "scripts/ralph-loop.sh plan",
    "ralph:loop": "scripts/ralph-loop.sh run",
    "ralph:loop:forever": "RALPH_MAX_ITERATIONS=0 scripts/ralph-loop.sh run",
    "ralph:loop:claude": "RALPH_BACKEND=claude scripts/ralph-loop.sh run",
    "ralph:loop:claude:forever": "RALPH_BACKEND=claude RALPH_MAX_ITERATIONS=0 scripts/ralph-loop.sh run",
    "ralph:gate": "bash scripts/ralph-quality-gate.sh",
    "ralph:implement": "bash scripts/ralph-implement.sh",
    "ralph:autopilot": "bash scripts/ralph-autopilot.sh",
    "ralph:audit": "bash .codex/ralph-audit/ralph.sh",
    "ralph:audit:no-search": "bash .codex/ralph-audit/ralph.sh --no-search",
    "discovery:delivery-methods": "tsx backend/scripts/provider-delivery-discovery.ts"
  },
  "lint-staged": {
    "{pnpm-lock.yaml,package.json,backend/package.json,frontend/package.json,infrastructure/cdk/package.json}": "node scripts/ci/precommit-audit.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "@aws-sdk/client-cloudwatch": "3.981.0",
      "@aws-sdk/client-ecs": "3.981.0",
      "@aws-sdk/client-elasticache": "3.981.0",
      "@aws-sdk/client-eventbridge": "3.981.0",
      "@aws-sdk/client-rds": "3.981.0",
      "@aws-sdk/client-s3": "3.981.0",
      "@aws-sdk/client-secrets-manager": "3.981.0",
      "@aws-sdk/client-ses": "3.981.0",
      "@aws-sdk/client-sns": "3.981.0",
      "@aws-sdk/client-sqs": "3.981.0",
      "@aws-sdk/client-ssm": "3.981.0",
      "@aws-sdk/s3-request-presigner": "3.981.0",
      "@aws-sdk/core": "3.973.11",
      "devalue": "5.6.3",
      "h3": "1.15.5",
      "tar": "7.5.9",
      "minimatch": "10.2.3",
      "rollup": "4.59.0",
      "koa": "2.16.4",
      "serialize-javascript": "7.0.3",
      "fast-xml-parser": "5.3.8",
      "esbuild": "0.25.0",
      "tmp": "0.2.4",
      "eslint>ajv": "6.14.0",
      "@stryker-mutator/core>ajv": "8.18.0",
      "bn.js": "5.2.3",
      "@isaacs/brace-expansion": "5.0.1",
      "qs": "6.15.0",
      "svgo": "4.0.1"
    }
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
